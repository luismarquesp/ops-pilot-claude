{
  "//": "A configuração funcional de permissões do agente Claude Code vive em .claude/settings.json — este arquivo é apenas um registro, pois o VSCode não interpreta permissions.allow/deny.",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npx tsc*)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(**/.env)",
      "Bash(cat *.env)",
      "Bash(type *.env)",
      "Bash(more *.env)",
      "Bash(Get-Content *.env)"
    ]
  }
}
