OPENROUTER_API_KEY=
OPEN_ROUTER_MODEL=
# Modelos reserva, separados por vírgula, tentados na ordem; 2 tentativas por modelo (specs/015)
OPENROUTER_MODEL_FALLBACK=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=

# Orçamento de contexto por seção em tokens estimados (specs/013); vazio = padrão 200 / 1200 / 300
CONTEXT_BUDGET_SUMMARY=
CONTEXT_BUDGET_WINDOW=
CONTEXT_BUDGET_MEMORY=

# Preço em USD por 1M tokens de prompt para o custo do GET /stats (specs/017); ids :free custam 0
# ex.: MODEL_PRICES=openai/gpt-4o-mini=0.15,anthropic/claude-sonnet-4=3
MODEL_PRICES=

# Origens de navegador aceitas pela API (specs/018), separadas por vírgula; vazio = nenhuma
# ex.: CORS_ORIGINS=http://localhost:5173,https://ops.example.com
CORS_ORIGINS=
